# Neon Postgres connection string.
# The Vercel <-> Neon integration injects DATABASE_URL automatically.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Secret required to save changes to the server (sent as x-admin-token).
# The editor asks for it the first time you change something.
ADMIN_TOKEN="choose-a-long-random-string"
